# Preserve binary documents and images without line-ending conversion.
*.pdf binary
*.xls binary
*.xlsx binary
*.xlsm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary

# Frozen inputs/results carry content hashes; do not rewrite their line endings.
*.json -text
*.csv -text
*.html -text
*.js -text
*.txt -text
